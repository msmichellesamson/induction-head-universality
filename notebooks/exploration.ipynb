    "print(f'Logits shape: {logits.shape}')  # [1, seq, vocab]\n",
    "print(f'Cache keys (first 5): {list(cache.keys())[:5]}')\n",
    "\n",
    "# Attention pattern keys look like 'blocks.0.attn.hook_pattern'\n",
