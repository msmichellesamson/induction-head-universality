    "## 4. Does sequence length matter?\n",
    "\n",
    "Quick sanity check: does the induction score depend on how long the repeated sequence is?\n",
    "It shouldn't vary dramatically if the head is genuinely doing pattern matching,\n",
    "but let me verify."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "seq_lengths_to_try = [10, 25, 50, 75, 100]\n",
    "\n",
    "# Only going up to model.cfg.n_ctx // 2 - a few tokens to be safe\n",
    "max_safe_len = model.cfg.n_ctx // 2 - 5\n",
    "seq_lengths_to_try = [s for s in seq_lengths_to_try if s <= max_safe_len]\n",
    "print(f'Testing seq lengths: {seq_lengths_to_try}')\n",
    "\n",
    "# For each seq len, compute scores and track max score across all heads\n",
    "seq_len_results = []\n",
    "\n",
    "for sl in seq_lengths_to_try:\n",
    "    tok = repeated_token_sequence(model, seq_len=sl, seed=42)\n",
    "    with torch.no_grad():\n",
    "        _, c = model.run_with_cache(tok)\n",
    "    r = compute_induction_scores(model, tok, c)\n",
    "    s = r['scores']\n",
    "    seq_len_results.append({\n",
    "        'seq_len': sl,\n",
    "        'max_score': float(s.max()),\n",
    "        'mean_top3': float(np.sort(s.flatten())[-3:].mean()),\n",
    "        'n_above_threshold': int((s > INDUCTION_THRESHOLD).sum()),\n",
    "    })\n",
    "    print(f'seq_len={sl}: max={s.max():.4f}, n_above_{INDUCTION_THRESHOLD}={(s > INDUCTION_THRESHOLD).sum()}')"
   ]
  },
