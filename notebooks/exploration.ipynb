    "import numpy as np\n",
    "import matplotlib\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.gridspec as gridspec\n",
    "from matplotlib.colors import LogNorm\n",
    "import json\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import transformer_lens\n",
    "from transformer_lens import HookedTransformer, utils as tl_utils\n",
    "\n",
    "# local stuff\n",
    "import sys\n",
    "sys.path.insert(0, '../src')\n",
    "from induction_score import compute_induction_scores, repeated_token_sequence\n",
    "from models import load_model\n",
    "\n",
    "print(f'torch: {torch.__version__}')\n",
    "print(f'transformer_lens: {transformer_lens.__version__}')\n",
    "print(f'CUDA available: {torch.cuda.is_available()}')\n",
    "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'using: {device}')\n",
    "\n",
    "# reproducibility — will matter more when I do the cross-model runs\n",
    "torch.manual_seed(42)\n",
    "np.random.seed(42)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Pythia-70M\n",
    "\n",
    "Starting with 70M because it's fast and I can iterate. The architecture is:\n",
    "- 6 layers, 8 heads per layer, d_model=512\n",
    "- Trained on The Pile, GPT-NeoX tokenizer\n",
    "\n",
    "TransformerLens wraps it nicely so I can hook into attention patterns directly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "model_name = 'pythia-70m'\n",
    "\n",
