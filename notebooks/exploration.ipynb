   "source": [
    "## 5. Multiple seeds — is it the same heads every time?\n",
    "\n",
    "If induction heads are a robust circuit, the *same* layer/head positions should score high\n",
    "regardless of which random tokens I use in the repeated sequence."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "n_seeds = 10\n",
    "all_scores = []\n",
    "\n",
    "for seed in range(n_seeds):\n",
    "    tok = repeated_token_sequence(model, seq_len=50, seed=seed)\n",
    "    with torch.no_grad():\n",
    "        _, c = model.run_with_cache(tok)\n",
    "    r = compute_induction_scores(model, tok, c)\n",
    "    all_scores.append(r['scores'])\n",
    "\n",
    "# Stack: [n_seeds, n_layers, n_heads]\n",
    "all_scores_arr = np.stack(all_scores, axis=0)\n",
    "\n",
    "mean_scores = all_scores_arr.mean(axis=0)\n",
    "std_scores = all_scores_arr.std(axis=0)\n",
    "\n",
    "print(f'Score stats across {n_seeds} seeds:')\n",
    "print(f'  Mean of means: {mean_scores.mean():.4f}')\n",
    "print(f'  Max mean score: {mean_scores.max():.4f}')\n",
    "print(f'  Max std: {std_scores.max():.4f}')\n",
    "print()\n",
    "\n",
    "# Which heads have high mean and low std? Those are the real induction heads.\n",
    "print('Heads with mean > 0.4:')\n",
    "high_mask = mean_scores > INDUCTION_THRESHOLD\n",
    "for (l, h) in zip(*np.where(high_mask)):\n",
    "    print(f'  L{l}H{h}: mean={mean_scores[l, h]:.4f} ± {std_scores[l, h]:.4f}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot mean ± std for the identified heads\n",
    "# This is more convincing than a single-seed number\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# Left: mean scores heatmap\n",
    "im1 = axes[0].imshow(mean_scores, cmap='viridis', vmin=0, vmax=1, interpolation='nearest')\n",
    "plt.colorbar(im1, ax=axes[0], label='Mean Induction Score')\n",
    "axes[0].set_title(f'Mean Induction Score\\n({n_seeds} seeds, seq_len=50)')\n",
